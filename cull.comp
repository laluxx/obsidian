#version 450
#extension GL_ARB_shader_draw_parameters : enable
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct MeshData {
    mat4  model;
    mat4  normalMatrix;
    int   albedoIndex;
    int   normalMapIndex;
    int   metallicRoughIndex;
    int   aoIndex;
    int   emissiveIndex;
    int   isUnlit;
    int   alphaMode;
    float alphaCutoff;
    vec4  baseColorFactor;
    float metallicFactor;
    float roughnessFactor;
    float emissiveStrength;
    int   _pad0;
    vec3  emissiveFactor;
    int   _pad1;
    vec4  aabbMin;
    vec4  aabbMax;
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0) readonly buffer MeshSSBO {
    MeshData meshes[];
};

layout(set = 0, binding = 1) readonly buffer SourceDrawSSBO {
    DrawCommand srcDraws[];
};

layout(set = 0, binding = 2) writeonly buffer DstDrawSSBO {
    DrawCommand dstDraws[];
};

layout(set = 0, binding = 3) uniform FrustumUBO {
    vec4     planes[6];
    uint     meshCount;
};

bool testAABB(vec3 aabbMin, vec3 aabbMax) {
    for (int i = 0; i < 6; i++) {
        vec3 n = planes[i].xyz;
        vec3 p;
        p.x = n.x >= 0.0 ? aabbMax.x : aabbMin.x;
        p.y = n.y >= 0.0 ? aabbMax.y : aabbMin.y;
        p.z = n.z >= 0.0 ? aabbMax.z : aabbMin.z;
        if (dot(n, p) + planes[i].w < 0.0) return false;
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= meshCount) return;

    DrawCommand src = srcDraws[idx];

    /* slots with no geometry stay invisible */
    if (src.indexCount == 0) {
        dstDraws[idx] = src;
        dstDraws[idx].instanceCount = 0;
        return;
    }

    MeshData m = meshes[idx];

    vec3 corners[8];
    corners[0] = vec3(m.aabbMin.x, m.aabbMin.y, m.aabbMin.z);
    corners[1] = vec3(m.aabbMax.x, m.aabbMin.y, m.aabbMin.z);
    corners[2] = vec3(m.aabbMin.x, m.aabbMax.y, m.aabbMin.z);
    corners[3] = vec3(m.aabbMax.x, m.aabbMax.y, m.aabbMin.z);
    corners[4] = vec3(m.aabbMin.x, m.aabbMin.y, m.aabbMax.z);
    corners[5] = vec3(m.aabbMax.x, m.aabbMin.y, m.aabbMax.z);
    corners[6] = vec3(m.aabbMin.x, m.aabbMax.y, m.aabbMax.z);
    corners[7] = vec3(m.aabbMax.x, m.aabbMax.y, m.aabbMax.z);

    vec3 worldMin = vec3( 1e30);
    vec3 worldMax = vec3(-1e30);
    for (int i = 0; i < 8; i++) {
        vec3 w = (m.model * vec4(corners[i], 1.0)).xyz;
        worldMin = min(worldMin, w);
        worldMax = max(worldMax, w);
    }

    /* copy src verbatim, only cull instanceCount */
    dstDraws[idx] = src;
    dstDraws[idx].instanceCount = testAABB(worldMin, worldMax) ? 1 : 0;
}

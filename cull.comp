#version 450
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct MeshData {
    mat4  model;
    int   textureIndex;
    int   isUnlit;
    int   alphaMode;
    float alphaCutoff;
    vec4  aabbMin;
    vec4  aabbMax;
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0) readonly buffer MeshSSBO {
    MeshData meshes[];
};

layout(set = 0, binding = 1) buffer DrawSSBO {
    DrawCommand draws[];
};

layout(set = 0, binding = 2) uniform FrustumUBO {
    vec4     planes[6];
    uint     meshCount;
};

bool testAABB(vec4 aabbMin, vec4 aabbMax) {
    for (int i = 0; i < 6; i++) {
        vec3 n = planes[i].xyz;
        /* p-vertex: corner of AABB most positive along plane normal */
        vec3 p;
        p.x = n.x >= 0.0 ? aabbMax.x : aabbMin.x;
        p.y = n.y >= 0.0 ? aabbMax.y : aabbMin.y;
        p.z = n.z >= 0.0 ? aabbMax.z : aabbMin.z;
        /* if p-vertex is outside this plane, AABB is fully culled */
        if (dot(n, p) + planes[i].w < 0.0) return false;
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= meshCount) return;

    /* meshes with instanceCount==0 set at CPU side (morph/dynamic) stay 0 */
    if (draws[idx].instanceCount == 0) return;

    MeshData m = meshes[idx];

    /* transform AABB into world space — expand by testing all 8 corners */
    vec3 corners[8];
    corners[0] = vec3(m.aabbMin.x, m.aabbMin.y, m.aabbMin.z);
    corners[1] = vec3(m.aabbMax.x, m.aabbMin.y, m.aabbMin.z);
    corners[2] = vec3(m.aabbMin.x, m.aabbMax.y, m.aabbMin.z);
    corners[3] = vec3(m.aabbMax.x, m.aabbMax.y, m.aabbMin.z);
    corners[4] = vec3(m.aabbMin.x, m.aabbMin.y, m.aabbMax.z);
    corners[5] = vec3(m.aabbMax.x, m.aabbMin.y, m.aabbMax.z);
    corners[6] = vec3(m.aabbMin.x, m.aabbMax.y, m.aabbMax.z);
    corners[7] = vec3(m.aabbMax.x, m.aabbMax.y, m.aabbMax.z);

    vec3 worldMin = vec3( 1e30);
    vec3 worldMax = vec3(-1e30);
    for (int i = 0; i < 8; i++) {
        vec3 w = (m.model * vec4(corners[i], 1.0)).xyz;
        worldMin = min(worldMin, w);
        worldMax = max(worldMax, w);
    }

    bool visible = testAABB(vec4(worldMin, 0.0), vec4(worldMax, 0.0));
    draws[idx].instanceCount = visible ? 1 : 0;
}

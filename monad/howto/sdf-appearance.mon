;;; sdf-appearance.mon --- copy appearance, paste it onto another primitive

:author Laluxx
:version 0.1.0
:keywords obsidian howto sdf-appearance

;;; Commentary:

Boot: OBSIDIAN_MONAD_BOOT=monad/howto/sdf-appearance.mon ./obsidian
Value-only transfer: geometry, transform, CSG and terrain octaves of the
target are preserved. The clipboard is engine-owned, never a pointer.

;;; Code:
(module Main)

(define (obsidian_camera_step_mm current)
  current)

(define (obsidian_middle_orbit_yaw_urad delta_millipixels)
  (* delta_millipixels 10))

(define (obsidian_middle_orbit_pitch_urad delta_millipixels)
  (* delta_millipixels 10))

(define (appearance-frame f)
  (if (= (frame-number f) 2)
      (begin
        (sdf-inspect-select! (sdf-ticket 0))
        (sdf-appearance-copy!)
        (sdf-inspect-select! (sdf-ticket 1))
        (sdf-appearance-paste!)
        True)
      True))

(on-frame! appearance-frame)

;;; material-reads.mon --- direct PBR channel reads and atomic factor writes

:author Laluxx
:version 0.1.0
:keywords obsidian howto material-reads

;;; Commentary:

Boot: OBSIDIAN_MONAD_BOOT=monad/howto/material-reads.mon ./obsidian
Frame 1 sets mesh 0 to semi-gloss charcoal in one atomic factors write;
every frame snapshots all six channels. Color writes live in
material-paint.mon; reusable presets live in material-on-mesh.mon.

;;; Code:

(module Main)

(define (obsidian_camera_step_mm current)
  current)

(define (obsidian_middle_orbit_yaw_urad delta_millipixels)
  (* delta_millipixels 10))

(define (obsidian_middle_orbit_pitch_urad delta_millipixels)
  (* delta_millipixels 10))

(define (snapshot-channels m)
  (list (material-red m) (material-green m) (material-blue m)
        (material-alpha m) (material-roughness m) (material-metallic m)))

(define (reads-frame f)
  (if (> (mesh-count (scene)) 0)
      (begin
        (if (= (frame-number f) 1)
            (begin (material-factors! (material (mesh 0)) 0.45 0.85) True)
            True)
        (snapshot-channels (material (mesh 0)))
        True)
      True))

(on-frame! reads-frame)

;;; material-paint.mon --- absolute PBR color on a live mesh, no preset asset

:author Laluxx
:version 0.1.0
:keywords obsidian howto material-paint

;;; Commentary:

Boot: OBSIDIAN_MONAD_BOOT=monad/howto/material-paint.mon ./obsidian
Paints mesh 0 ember orange on the first frame with meshes present.
For reusable presets see material-on-mesh.mon; for preset cycling see
material-preset-cycle.mon.

;;; Code:
(module Main)

(define (obsidian_camera_step_mm current)
  current)

(define (obsidian_middle_orbit_yaw_urad delta_millipixels)
  (* delta_millipixels 10))

(define (obsidian_middle_orbit_pitch_urad delta_millipixels)
  (* delta_millipixels 10))

(define (paint-frame f)
  (if (and (= (frame-number f) 1)
           (> (mesh-count (scene)) 0))
      (begin
        (material-color! (material (mesh 0)) 0.85 0.22 0.08 1.0)
        True)
      True))

(on-frame! paint-frame)

#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// MeshData mirror — only the fields we need for stream routing.
// Must match MeshGPUData layout in renderer.h exactly up to transmissionFactor.
struct MeshData {
    mat4  model;          // 64 bytes
    int   albedoIndex;    // +64
    int   normalMapIndex;
    int   metallicRoughIndex;
    int   aoIndex;
    int   emissiveIndex;  // +80
    int   isUnlit;
    int   alphaMode;      // +88
    float alphaCutoff;
    vec4  baseColorFactor;
    float metallicFactor;
    float roughnessFactor;
    float emissiveStrength;
    int   displacementIndex;
    vec3  emissiveFactor;
    float displacementScale;
    vec4  aabbMin;
    vec4  aabbMax;
    int   jointOffset;
    int   morphDeltaOffset;
    int   morphWeightOffset;
    int   morphCount;
    float transmissionFactor;
    float ior;
    float thicknessFactor;
    int   transmissionIndex;
    int   thicknessIndex;
    float attenuationColorR;
    float attenuationColorG;
    float attenuationColorB;
    float attenuationDistance;
    float dispersion;
    int   isVisible;
    int   isWireframe;
};

layout(set = 0, binding = 0) readonly buffer VisibilityBuffer   { uint visibility[]; };
layout(set = 0, binding = 1) readonly buffer SrcIndirectBuffer  { DrawCommand srcDraws[]; };
layout(set = 0, binding = 2) writeonly buffer DstIndirectBuffer { DrawCommand dstDraws[]; };
layout(set = 0, binding = 3) buffer DrawCountBuffer             { uint drawCounts[]; };

// NEW: binding 4 — the mesh SSBO so we can read alphaMode and transmissionFactor
layout(set = 0, binding = 4) readonly buffer MeshSSBO           { MeshData meshes[]; };

layout(push_constant) uniform PC {
    uint meshCount;
    uint maxMeshes;       // slot stride = 20480 draws per frustum per stream
    uint opaqueMeshCount; // unused now — we route by material property
    uint staticMeshCount; // first dynamic mesh index
} pc;

void main() {
    uint frustumIdx = gl_GlobalInvocationID.x;
    uint writeOffset = frustumIdx * pc.maxMeshes;

    uint opqCount  = 0; // Stream 0: opaque + transmission
    uint xmtCount  = 0; // Stream 1: transmission
    uint trnCount  = 0; // Stream 2: alpha blend
    uint wireCount = 0; // Stream 3: wireframe

    // Slot stride per stream within indirectBuffer:
    // Using equal fourths of maxMeshes=20480 => 5120 each (safe)
    uint streamStride = pc.maxMeshes / 4u;

    for (uint i = 0; i < pc.meshCount; i++) {
        if (visibility[frustumIdx * pc.meshCount + i] == 0u) continue;

        DrawCommand cmd = srcDraws[i];
        if (cmd.instanceCount == 0u) continue;

        // Dynamic meshes (past staticMeshCount) are always opaque
        if (i >= pc.staticMeshCount) {
            dstDraws[writeOffset + opqCount++] = cmd;
            continue;
        }

        MeshData m = meshes[i];
        int alphaMode = m.alphaMode;
        float transmission = m.transmissionFactor;

        if (m.isWireframe != 0) {
            // Wireframe: drawn in dedicated pass with VK_POLYGON_MODE_LINE
            dstDraws[writeOffset + 3u * streamStride + wireCount++] = cmd;
        } else if (transmission > 0.0) {
            // Transmission: needs screen copy — drawn in dedicated pass after copy
            dstDraws[writeOffset + streamStride + xmtCount++] = cmd;
        } else if (alphaMode == 2) {
            // Alpha blend transparent: drawn last
            dstDraws[writeOffset + 2u * streamStride + trnCount++] = cmd;
        } else {
            // Opaque or alpha mask: drawn first
            dstDraws[writeOffset + opqCount++] = cmd;
        }
    }

    // drawCounts layout per frustum: [opaque, transmission, transparent, wireframe]
    // Total 4 uints per frustum, 5 frustums = 20 uints needed.
    drawCounts[frustumIdx * 4u + 0u] = opqCount;
    drawCounts[frustumIdx * 4u + 1u] = xmtCount;
    drawCounts[frustumIdx * 4u + 2u] = trnCount;
    drawCounts[frustumIdx * 4u + 3u] = wireCount;
}

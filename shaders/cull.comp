#version 450
#extension GL_ARB_shader_draw_parameters : enable
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct MeshData {
    mat4  model;
    mat4  normalMatrix;
    int   albedoIndex;
    int   normalMapIndex;
    int   metallicRoughIndex;
    int   aoIndex;
    int   emissiveIndex;
    int   isUnlit;
    int   alphaMode;
    float alphaCutoff;
    vec4  baseColorFactor;
    float metallicFactor;
    float roughnessFactor;
    float emissiveStrength;
    int   _pad0;
    vec3  emissiveFactor;
    int   _pad1;
    vec4  aabbMin;
    vec4  aabbMax;
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0) readonly buffer MeshSSBO { MeshData meshes[]; };
layout(set = 0, binding = 1) readonly buffer SourceDrawSSBO { DrawCommand srcDraws[]; };
layout(set = 0, binding = 2) writeonly buffer DstDrawSSBO { DrawCommand dstDraws[]; };

layout(set = 0, binding = 3) uniform FrustumUBO {
    vec4 planes[5][6]; // [0] = Camera, [1-4] = Cascades
    uint meshCount;
    uint frustumCount;
    uint _pad[2];
} ubo;

// Maniacal branchless AABB intersection
bool testAABB(vec3 worldMin, vec3 worldMax, uint fIdx) {
    for (int i = 0; i < 6; i++) {
        vec4 plane = ubo.planes[fIdx][i];
        vec3 p = mix(worldMin, worldMax, greaterThan(plane.xyz, vec3(0.0)));
        if (dot(plane.xyz, p) + plane.w < 0.0) return false;
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= ubo.meshCount) return;

    DrawCommand src = srcDraws[idx];

    // Slots with no geometry stay invisible across all frustums
    if (src.indexCount == 0) {
        for(uint c = 0; c < ubo.frustumCount; c++) {
            dstDraws[c * ubo.meshCount + idx] = src;
            dstDraws[c * ubo.meshCount + idx].instanceCount = 0;
        }
        return;
    }

    MeshData m = meshes[idx];

    vec3 corners[8] = vec3[](
        vec3(m.aabbMin.x, m.aabbMin.y, m.aabbMin.z), vec3(m.aabbMax.x, m.aabbMin.y, m.aabbMin.z),
        vec3(m.aabbMin.x, m.aabbMax.y, m.aabbMin.z), vec3(m.aabbMax.x, m.aabbMax.y, m.aabbMin.z),
        vec3(m.aabbMin.x, m.aabbMin.y, m.aabbMax.z), vec3(m.aabbMax.x, m.aabbMin.y, m.aabbMax.z),
        vec3(m.aabbMin.x, m.aabbMax.y, m.aabbMax.z), vec3(m.aabbMax.x, m.aabbMax.y, m.aabbMax.z)
    );

    vec3 worldMin = vec3( 1e30);
    vec3 worldMax = vec3(-1e30);
    for (int i = 0; i < 8; i++) {
        vec3 w = (m.model * vec4(corners[i], 1.0)).xyz;
        worldMin = min(worldMin, w);
        worldMax = max(worldMax, w);
    }

    // Output a tailored draw command for EVERY active frustum
    for(uint c = 0; c < ubo.frustumCount; c++) {
        dstDraws[c * ubo.meshCount + idx] = src;
        dstDraws[c * ubo.meshCount + idx].instanceCount = testAABB(worldMin, worldMax, c) ? 1 : 0;
    }
}

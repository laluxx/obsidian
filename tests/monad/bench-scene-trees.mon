;;; bench-scene-trees.mon --- Small bundled scene for fast Monad-selected headless profiling.

:author Laluxx
:version 0.1.0
:keywords obsidian tests contract bench-scene-trees

;;; Commentary:

scene-id 2 selects assets/gltf/trees.glb; cache-mode 0 = cold, 1 = warm.
Run with: make bench-monad BENCH_MONAD_MANIFEST=tests/monad/bench-scene-trees.mon

;;; Code:
(define (obsidian-benchmark-scene-id [ignored : Int] -> Int) 2)
(define (obsidian-benchmark-width [ignored : Int] -> Int) 1280)
(define (obsidian-benchmark-height [ignored : Int] -> Int) 720)
(define (obsidian-benchmark-warmup [ignored : Int] -> Int) 120)
(define (obsidian-benchmark-frames [ignored : Int] -> Int) 600)
(define (obsidian-benchmark-cache-mode [ignored : Int] -> Int) 0)
(define (obsidian-benchmark-min-meshes [ignored : Int] -> Int) 1)

;;; bench-scene.mon --- Integer accessors define a benchmark without a second manifest parser.

:author Laluxx
:version 0.1.0
:keywords obsidian tests contract bench-scene

;;; Commentary:

scene-id: 1 Sponza, 2 trees, 3 NodePerformanceTest, 4 VertexColorTest,
5 xmp, 6 TransmissionTest, 7 Unicode test, 8 UnlitTest, 9 texture test,
10 bundled triangle, 11 bundled instancing, 12 meshlet growth.
cache-mode 0 = cold, 1 = warm.
Run with: make bench-monad BENCH_MONAD_MANIFEST=tests/monad/bench-scene.mon

;;; Code:
(define (obsidian-benchmark-scene-id [ignored : Int] -> Int) 1)
(define (obsidian-benchmark-width [ignored : Int] -> Int) 1280)
(define (obsidian-benchmark-height [ignored : Int] -> Int) 720)
(define (obsidian-benchmark-warmup [ignored : Int] -> Int) 120)
(define (obsidian-benchmark-frames [ignored : Int] -> Int) 600)
(define (obsidian-benchmark-cache-mode [ignored : Int] -> Int) 0)
(define (obsidian-benchmark-min-meshes [ignored : Int] -> Int) 1)
